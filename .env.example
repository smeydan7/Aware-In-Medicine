# Copy this file to `.env.local` and fill in values as needed.
# `.env.local` is gitignored; this example file is safe to commit.

# ── AI chatbot (optional) ────────────────────────────────────────────────
# The chatbot is disabled by default. To enable it:
#   1. Set NEXT_PUBLIC_CHATBOT_ENABLED=true
#   2. Provide a server-side Anthropic API key below.

# Show the chatbot widget (true/false). Default: false.
NEXT_PUBLIC_CHATBOT_ENABLED=false

# Anthropic API key — only needed when the chatbot is enabled.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
