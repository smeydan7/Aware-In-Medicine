# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Used to embed condition text (ingest script) and user queries (search route).
# Model: text-embedding-3-small. Server-only — never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-...

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and anon key. Both are safe to expose to the browser: the anon
# key only grants what your RLS policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key bypasses RLS entirely. Used ONLY by scripts/embed-conditions.ts
# to write embeddings. Never reference this from a component or route handler,
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Feature flags ────────────────────────────────────────────────────────────
# Semantic search on the Conditions Library. When false (or when OPENAI_API_KEY
# is unset), the search box silently falls back to plain name matching.
NEXT_PUBLIC_SEMANTIC_SEARCH_ENABLED=true

# AI chatbot widget. Currently has no backing route — leave false.
NEXT_PUBLIC_CHATBOT_ENABLED=false
